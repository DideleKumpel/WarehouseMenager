<Window x:Class="WarehouseMenager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarehouseMenager"
        xmlns:viewmodels="clr-namespace:WarehouseMenager.ViewModel"
        xmlns:views="clr-namespace:WarehouseMenager.View"
        mc:Ignorable="d"
        Title="Warehouse Menager" Height="650" Width="1200">
    <Window.Resources>
        <DataTemplate x:Name="loginPanelViewTemplate" DataType="{x:Type viewmodels:loginPanelViewModel}">
            <views:loginPanelView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Name="operatorPanelViewTemplate" DataType="{x:Type viewmodels:operatorPanelViewModel}">
            <views:operatorPanelView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate x:Name="menagerPanelViewTemplate" DataType="{x:Type viewmodels:menagerPanelViewModel}">
            <views:menagerPanelView DataContext="{Binding}"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <ContentControl Content="{Binding}"/>
    </Grid>
</Window>
